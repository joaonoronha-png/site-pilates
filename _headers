# Security headers for static hosts that read this file (Netlify, Cloudflare Pages).
# If you deploy elsewhere (Vercel, S3+CloudFront, Nginx, etc.), configure the
# equivalent headers in that platform's own config instead of this file.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'; frame-src https://www.google.com; connect-src 'self'
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
