# Domínio público do site — ativa canonical, Open Graph absoluto e sitemap.xml
SITE_URL=

# Ativa o Assistente BCM com IA (rota do backend). Deixe vazio para o modo local.
VITE_ASSISTANT_ENDPOINT=

# Somente no servidor (nunca exponha no frontend). Necessária se o endpoint acima estiver ativo.
ANTHROPIC_API_KEY=
# Opcional: outro modelo para o assistente
ASSISTANT_MODEL=
